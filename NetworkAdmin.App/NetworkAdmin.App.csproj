<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CoreOps</AssemblyName>
    <Product>CoreOps</Product>
    <Description>Network administration and inventory console</Description>
    <Authors>CoreOps contributors</Authors>
    <Company>CoreOps Project</Company>
    <Copyright>Copyright © 2026 CoreOps contributors</Copyright>
    <RepositoryUrl>https://github.com/xotan135/CoreOps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <InformationalVersion>0.9.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\CoreOps.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\network-admin-logo-v3.png" />
    <Resource Include="Assets\CoreOps.ico" />
  </ItemGroup>

</Project>
