<Window x:Class="NetworkAdmin.App.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreOps — Remote Maintenance" Icon="/Assets/CoreOps.ico"
        Width="1050" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#151515" Foreground="#F1F1F1">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#181818"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#476F6C"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#353535"/><Setter Property="BorderBrush" Value="#646464"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#303030"/><Setter Property="BorderBrush" Value="#606060"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="Background" Value="#292929"/><Setter Property="BorderBrush" Value="#494949"/><Setter Property="Padding" Value="16,8"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#315C59"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#181818"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="RowBackground" Value="#1B1B1B"/><Setter Property="AlternatingRowBackground" Value="#222222"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#303030"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="7,5"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="#202020" BorderBrush="#343434" BorderThickness="0,0,0,1" Padding="20,8">
      <DockPanel><Image Source="/Assets/network-admin-logo-v3.png" Width="54" Height="54" DockPanel.Dock="Left" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="24" FontWeight="SemiBold"><Run Text="CORE"/><Run Text="OPS" Foreground="#78DDD7"/><Run Text="  REMOTE MAINTENANCE" Foreground="#BDBDBD" FontSize="17"/></TextBlock><TextBlock Text="Manage Windows services and safely clean aged temporary files." Foreground="#AFAFAF" FontSize="11"/></StackPanel></DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="6"/><RowDefinition x:Name="MaintenanceLogRow" Height="90" MinHeight="50"/></Grid.RowDefinitions>
      <Border Background="#202020" BorderBrush="#414141" BorderThickness="1" CornerRadius="7" Padding="12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Target computers" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="TargetsTextBox" Height="58" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel><Button Grid.Column="1" Content="Select from domain…" Margin="10,23,0,0" VerticalAlignment="Top" Click="SelectDomainButton_Click"/></Grid>
      </Border>

      <TabControl Grid.Row="2" x:Name="OperationsTabs" Background="#1B1B1B" BorderBrush="#414141">
        <TabItem Header="Windows services">
          <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Service name:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ServiceNameTextBox" Grid.Column="1" ToolTip="Enter the exact Windows service name, such as Spooler"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal"><Button x:Name="QueryServiceButton" Content="Check status" Click="QueryServiceButton_Click"/><Button x:Name="StartServiceButton" Content="Start" Click="StartServiceButton_Click"/><Button x:Name="StopServiceButton" Content="Stop…" Background="#403536" BorderBrush="#76595C" Click="StopServiceButton_Click"/><Button x:Name="RestartServiceButton" Content="Restart…" Background="#403536" BorderBrush="#76595C" Click="RestartServiceButton_Click"/></StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Temporary-file cleanup">
          <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Cleans C:\Windows\Temp and each local profile's AppData\Local\Temp. Temp roots and reparse points are never deleted." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="Minimum file age:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="CleanupAgeComboBox" Width="110" SelectedIndex="0"><ComboBoxItem Content="7 days" Tag="7"/><ComboBoxItem Content="14 days" Tag="14"/><ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="60 days" Tag="60"/></ComboBox></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button x:Name="PreviewCleanupButton" Content="Preview" Click="PreviewCleanupButton_Click"/><Button x:Name="RunCleanupButton" Content="Clean files…" Background="#403536" BorderBrush="#76595C" Click="RunCleanupButton_Click"/></StackPanel>
          </Grid>
        </TabItem>
      </TabControl>

      <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><Button Content="Session report" Click="ReportButton_Click"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="CancelButton_Click"/></StackPanel><TextBlock Text="Up to 4 computers run in parallel" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="150"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="160"/><DataGridTextColumn Header="Service / scope" Binding="{Binding Item}" Width="190"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
      <GridSplitter Grid.Row="5" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="#4C4C4C" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
      <TextBox x:Name="LogTextBox" Grid.Row="6" IsReadOnly="True" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>

    <Border Grid.Row="2" Background="#202020" BorderBrush="#343434" BorderThickness="0,1,0,0" Padding="18,0"><Grid><TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#BEBEBE" VerticalAlignment="Center"/><ProgressBar x:Name="ProgressBar" Width="190" Height="4" HorizontalAlignment="Right" IsIndeterminate="True" Visibility="Collapsed" Foreground="#A7E7E3" Background="#303030"/></Grid></Border>
  </Grid>
</Window>
