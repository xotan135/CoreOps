<Window x:Class="NetworkAdmin.App.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreOps session report" Icon="/Assets/CoreOps.ico"
        Width="1120" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#151515">
    <Grid Margin="14">
        <Border Background="#151515" BorderBrush="#3D3D3D" BorderThickness="1">
            <WebBrowser x:Name="ReportBrowser"/>
        </Border>
    </Grid>
</Window>
