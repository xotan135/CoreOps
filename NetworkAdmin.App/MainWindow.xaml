<Window x:Class="NetworkAdmin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreOps" Icon="/Assets/CoreOps.ico" Height="720" Width="1100" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResize" Background="#151515" Foreground="#F1F1F1">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#202020"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A7E7E3"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#606060"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9"/><Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#181818"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#555555"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="#303030" BorderBrush="#606060" BorderThickness="1">
                                <Grid Margin="9,0,7,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="#FFFFFF"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#D8D8D8"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#2B2B2B" BorderBrush="#606060" BorderThickness="1" Padding="1">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#505050"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#454545"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#484848"/><Setter Property="Padding" Value="9,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#323232"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1C1C1C"/><Setter Property="Foreground" Value="#E8E8E8"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#242424"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#494949"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/><RowDefinition Height="6"/><RowDefinition x:Name="InputSectionRow" Height="250" MinHeight="185"/>
            <RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Height="90" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="80" Height="80" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="CoreGlow" Width="66" Height="66" Fill="#59DAD2" Opacity="0.10"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Ellipse.RenderTransform>
                    <Ellipse.Effect><BlurEffect Radius="25"/></Ellipse.Effect>
                </Ellipse>
                <Image x:Name="CoreLogo" Source="/Assets/network-admin-logo-v3.png" Width="78" Height="78"
                       Stretch="Uniform" SnapsToDevicePixels="True" Opacity="0.92">
                    <Image.Effect><DropShadowEffect Color="#62DED7" BlurRadius="12" ShadowDepth="0" Opacity="0.34"/></Image.Effect>
                </Image>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="CoreGlow" Storyboard.TargetProperty="Opacity"
                                             From="0.07" To="0.32" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetName="CoreGlow"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             From="0.92" To="1.10" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetName="CoreGlow"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             From="0.92" To="1.10" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetName="CoreLogo" Storyboard.TargetProperty="Opacity"
                                             From="0.90" To="1.0" Duration="0:0:2.2"/>
                        </Storyboard>
                    </BeginStoryboard></EventTrigger>
                </Grid.Triggers>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="SemiBold"
                           LineHeight="33" TextOptions.TextFormattingMode="Display">
                    <Run Text="CORE" Foreground="#F2F2F2"/><Run Text="OPS" Foreground="#78DDD7"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="2,-2,0,0">
                    <TextBlock Text="N E T W O R K   A D M I N   C O N S O L E"
                               FontFamily="Segoe UI Semibold" FontSize="9" Foreground="#8E8E8E"
                               VerticalAlignment="Center"/>
                    <Border Background="#292929" BorderBrush="#454545" BorderThickness="1"
                            CornerRadius="8" Padding="7,2" Margin="11,0,0,0">
                        <TextBlock x:Name="AppVersionTextBlock" Text="v0.11.2" FontFamily="Consolas"
                                   FontSize="9" Foreground="#BEBEBE"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#315C59" BorderBrush="#72DAD4" BorderThickness="1" CornerRadius="5" Padding="11,6">
                        <TextBlock Text="Network admin" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Button Content="Windows LAPS" Margin="8,0,0,0" Padding="11,6" Click="OpenLapsButton_Click"/>
                    <Button Content="Dell updates" Margin="8,0,0,0" Padding="11,6" Click="OpenDcuButton_Click"/>
                </StackPanel>
                <Border Background="#202020" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="13" Padding="11,6" Margin="0,7,0,0" MaxWidth="390">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#65D9B5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#D2D2D2" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16" Panel.ZIndex="2">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="TargetPaneColumn" Width="2*" MinWidth="260"/><ColumnDefinition Width="10"/><ColumnDefinition x:Name="ProtectedPaneColumn" Width="*" MinWidth="220"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Computer names" FontWeight="SemiBold" Foreground="#F1F1F1" VerticalAlignment="Center"/>
                        <Button Content="Select from domain…" HorizontalAlignment="Right" Margin="0" Padding="12,5"
                                Click="OpenDomainPickerButton_Click"/>
                    </Grid>
                    <TextBox x:Name="ComputerNamesTextBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             ToolTip="Enter DNS or NetBIOS names separated by commas, spaces, or new lines"/>
                    <TextBlock Grid.Row="2" Text="Example: workstation-01, server-02" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="#4C4C4C" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ToolTip="Drag to resize the computer lists"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Protected computers" FontWeight="SemiBold" Foreground="#F1F1F1" Margin="0,0,0,6"/>
                    <TextBox x:Name="ProtectedNamesTextBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             ToolTip="Stored only in your local CoreOps settings"/>
                    <TextBlock Grid.Row="2" Text="Restart is blocked for these computers." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                    <TextBlock Text="Inventory workbook" FontWeight="SemiBold" Foreground="#F1F1F1" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="InventoryPathTextBox"
                                 ToolTip="Path to an existing macro-enabled inventory workbook; stored only in local settings"/>
                        <Button x:Name="BrowseInventoryButton" Grid.Column="1" Content="Browse…" Margin="9,0,0,0"
                                Padding="17,8" Click="BrowseInventoryButton_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      Background="#4C4C4C" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ToolTip="Drag to resize the input area and activity log"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="CheckButton" Content="Check WinRM" Click="CheckButton_Click" Background="#383838" BorderBrush="#666666"/>
                    <Button x:Name="InventoryButton" Content="Collect inventory" Click="InventoryButton_Click" Background="#3A3A3A" BorderBrush="#747474"/>
                    <Button x:Name="RestartButton" Content="Restart…" Click="RestartButton_Click" Background="#403536" BorderBrush="#76595C"/>
                    <Button x:Name="ReportButton" Content="Session report" Click="ReportButton_Click" Background="#303B3B" BorderBrush="#55706E"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Parallel jobs:" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="ParallelismComboBox" Width="58" SelectedIndex="1">
                        <ComboBoxItem Content="1"/><ComboBoxItem Content="4"/><ComboBoxItem Content="8"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <TextBox x:Name="LogTextBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     Background="#111111" Foreground="#D1D1D1" BorderBrush="#353535" BorderThickness="1"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <ProgressBar x:Name="ProgressBar" Height="5" Width="220" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}" Background="#303030" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
