<Window x:Class="NetworkAdmin.App.ProtectedComputersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoreOps — Protected Computers" Icon="/Assets/CoreOps.ico"
        Width="560" Height="500" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#151515" Foreground="#F1F1F1">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="17,9"/><Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#606060"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Protected computers" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="#AAAAAA" TextWrapping="Wrap"
                   Text="Remote restart is blocked for the computers listed here. Enter one DNS or NetBIOS name per line."/>
        <TextBox x:Name="NamesTextBox" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 Padding="10" FontFamily="Consolas" Background="#181818" Foreground="#F2F2F2"
                 BorderBrush="#4A4A4A" CaretBrush="White" SelectionBrush="#555555"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="CancelButton_Click"/>
            <Button Content="Save" Click="SaveButton_Click" Background="#315C59" BorderBrush="#72DAD4"/>
        </StackPanel>
    </Grid>
</Window>
